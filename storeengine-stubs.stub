         *
         * @return bool True if no elements satisfy the predicate, otherwise false.
         *
         * @since 1.8.0
         */
        public static function none(array $arr, callable $predicate, bool $strict = false): bool
        {
        }
        /**
         * Alias of {@see ArrayUtil::every()}.
