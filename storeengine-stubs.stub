         * @param \StoreEngine\Addons\Subscription\Classes\Subscription $subscription
         * @param string $new_status
         *
         * @return void
         */
        public function subscription_status_updated(\StoreEngine\Addons\Subscription\Classes\Subscription $subscription, string $new_status)
        {
        }
        /**
         * Installment plan status handler.
         *
         * @param \StoreEnginePro\Addons\InstallmentPlan\Classes\InstallmentPlan $installment_plan
