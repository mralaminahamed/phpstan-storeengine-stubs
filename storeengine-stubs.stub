namespace StoreEngine\Interfaces {
    interface IntegrationInterface
    {
        public function setup(): void;
        public function dispatch_hooks(): void;
        public function get_id(): string;
        public function get_label(): string;
        public function get_logo(): string;
        public function enabled(): bool;
    }
}
namespace StoreEngine\Integrations {
    abstract class AbstractIntegration implements \StoreEngine\Interfaces\IntegrationInterface
    {
        /**
         * Integration instances.
         *
         * @var \StoreEngine\Interfaces\IntegrationInterface[]
         */
        protected static array $integrations = [];
        /**
         * Integration type id.
         * @var string
         */
        protected string $id;
        /**
         * Integration display name.
         * @var string
         */
        protected string $label;
        /**
         * Integration items label.
         * @var string
         */
        protected string $items_label;
        /**
         * Integration logo/icon.
         * @var string
         */
        protected string $logo;
        /**
         * Whether the integration is enabled (with all the dependencies).
         * @var bool
         */
        protected bool $isEnabled = false;
        public function __construct()
        {
        }
        /**
         * Get integration class instance by type.
         * Access integration singleton class instance.
         *
         * @param string $id
         *
         * @return ?\StoreEngine\Interfaces\IntegrationInterface
         */
        public static function get_integration(string $id): ?\StoreEngine\Interfaces\IntegrationInterface
        {
        }
        /**
         * Sets-up class props before dispatch.
         * @return void
         */
        abstract public function setup(): void;
        /**
         * Dispatch Hooks.
         *
         * @return void
         */
        abstract public function dispatch_hooks(): void;
        /**
         * Integration type id.
         *
         * @return string
         */
        public function get_id(): string
        {
        }
        /**
         * Display name/label.
         *
         * @return string
         */
        public function get_label(): string
        {
        }
        /**
         * Logo/icon.
         *
         * @return string
         */
        public function get_logo(): string
        {
        }
        /**
         * Is enabled?.
         *
         * @return bool
         */
        public function enabled(): bool
        {
        }
        /**
         * Items label.
         *
         * @return string
         */
        public function get_items_label(): string
        {
        }
        /**
         * Search integration items.
         *
         * @param array $args Search params.
         *
         * @return array<object{value:string, label:string}> Search results.
         */
        abstract public function get_items(array $args = []): array;
        /**
         * Triggers a purchase event for integration.
         *
         * @param \StoreEngine\Classes\Integration $integration
         * @param \StoreEngine\Classes\AbstractOrder $order
         *
         * @return void
         */
        abstract protected function purchase_created(\StoreEngine\Classes\Integration $integration, \StoreEngine\Classes\AbstractOrder $order);
        /**
         * Triggers a return/refund/void-sale event for integration.
         *
         * @param \StoreEngine\Classes\Integration $integration
         * @param \StoreEngine\Classes\AbstractOrder $order
         *
         * @return void
         */
        abstract protected function purchase_removed(\StoreEngine\Classes\Integration $integration, \StoreEngine\Classes\AbstractOrder $order);
        /**
         * Common hooks.
         *
         * Triggers purchase & refund/refound related events from order status events.
         *
         * @return void
         */
        protected function dispatch_common_hooks(): void
        {
        }
        /**
         * Checks if the integration should trigger its events.
         *
         * Third-party plugin/addon request not to trigger certain event and handle themselves.
         *
         * @param \StoreEngine\Classes\Order\OrderItemProduct $order_item
         *
         * @return bool
         */
        protected function should_run(\StoreEngine\Classes\Order\OrderItemProduct $order_item): bool
        {
        }
        /**
         * Order payment status handler.
         *
         * @param \StoreEngine\Classes\Order $order
         * @param string $status
         *
         * @return void
         */
        public function order_payment_status_changed(\StoreEngine\Classes\Order $order, string $status)
        {
        }
        /**
         * Subscription active status handler.
         *
         * @param \StoreEngine\Addons\Subscription\Classes\Subscription $subscription
