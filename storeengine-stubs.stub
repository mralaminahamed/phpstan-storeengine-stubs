         */
        public function apply_to_renewal(\StoreEngine\Classes\Order $order, ?\StoreEngine\Addons\Subscription\Classes\Subscription $subscription = null): \StoreEngine\Classes\Order
        {
        }
        /**
         * While re-applying a recurring coupon at renewal, treat it as valid so an
